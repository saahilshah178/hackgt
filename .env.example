# ---------------------------------------------------------------------------
# Quest Forge environment. Copy to .env.local (gitignored). FIRST_RUN.md walks
# through every step. Nothing here is needed for mock mode.
# ---------------------------------------------------------------------------

# Which model backend generates games.
#   mock  = MockLanguageModelV4 serving recorded fixture responses (no keys, no network, free)
#   live  = OpenAI through the AI SDK (needs OPENAI_API_KEY)                  -> FIRST_RUN.md step 3
LLM_MODE=mock

# Where sources, pages, knowledge maps, matches and games are stored.
#   local    = JSON + files under .data/ (default)
#   supabase = Postgres tables + Storage buckets (needs the Supabase vars)      -> FIRST_RUN.md step 6
STORAGE_DRIVER=local

# Voice, music and sound effects through ElevenLabs.
#   off  = games ship text-only (default)
#   live = synthesize narrative lines and load the audio library (needs ELEVENLABS_API_KEY) -> FIRST_RUN.md step 5
AUDIO_MODE=off

# OpenAI secret key (server only). Required when LLM_MODE=live.            -> FIRST_RUN.md step 3
OPENAI_API_KEY=

# Model ids per tier (server only). Confirm these against OpenAI's model list at first run.
#   SMART: curriculum, director, challenge writers.   FAST: gatekeeper, matcher, narrative, assessment, blind solve.
#   CODER: stretch only (wildcard mechanic).
SMART_MODEL=gpt-6-sol
FAST_MODEL=gpt-6-luna
CODER_MODEL=gpt-6-astra

# ElevenLabs API key (server only). Required when AUDIO_MODE=live.         -> FIRST_RUN.md step 5
ELEVENLABS_API_KEY=
# Optional JSON map from voiceArchetype to an ElevenLabs voice id, e.g. {"narrator":"JBFqnCBsd6RMkjVDRZzb"}
ELEVENLABS_VOICE_MAP=
# 1 = also synthesize a two-speaker Text to Dialogue intro (eleven_v3) when AUDIO_MODE=live. Default 0.
AUDIO_DIALOGUE=0

# Supabase project URL (public; safe in the browser).                      -> FIRST_RUN.md step 6
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (public; low privilege). Format: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (SERVER ONLY; bypasses RLS). Format: sb_secret_...
SUPABASE_SECRET_KEY=

# Stretch: Google Gemini for the curriculum agent (MLH "Best Use of Gemini API"). Unused tonight.
GOOGLE_GENERATIVE_AI_API_KEY=
