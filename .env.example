# Pick one provider and set its key. Without a key the app runs in mock mode.
AI_PROVIDER=openai            # openai | anthropic | google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides (defaults live in src/pipeline/models.ts)
# AI_FAST_MODEL=
# AI_SMART_MODEL=
# AI_MAX_CONCURRENT=6
# AI_MOCK=1                    # force mock mode even with a key

# Later steps
ELEVENLABS_API_KEY=

# Where JSON records and uploads are kept (default ./data)
# DATA_DIR=
