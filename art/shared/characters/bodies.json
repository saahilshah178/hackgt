        { "group": "^arm_0_Layer0_0_FILL$", "map": { "#E7F3FC": "sleeve", "#BF7958": "skin" } },
        { "group": "^arm_0_Layer0_1_FILL$", "map": { "#BFD4E5": "sleeveShade" } },
        { "group": "^hand_", "map": { "#BF7958": "skin", "#A8603F": "skinShade" } },
        { "group": "^leg", "map": { "#676AC6": "bottom", "#BF7958": "skin", "#E7F3FC": "sock", "#BFD4E5": "sock", "#EEA160": "boots", "#D78B49": "boots", "#4C4EAA": "boots", "#FFFFFF": "sock" } }
