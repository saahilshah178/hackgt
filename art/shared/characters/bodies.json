        { "group": "^head_0_Layer0_1_MEMBER_2_MEMBER_1|^headShock_0_Layer0_1_MEMBER_2_MEMBER_1", "map": { "#A8603F": "skinShade", "#FFFFFF": "eyeWhite" } },
        { "group": "^(head|headFocus|headShock|headBack)_0_Layer0_", "map": { "#BF7958": "skin", "#A8603F": "skinShade", "#955435": "skinDeep", "#3C3E41": "hair", "#454A51": "hairHi", "#71A2BE": "band", "#EEA160": "accent", "#FFFFFF": "eyeWhite" } },
