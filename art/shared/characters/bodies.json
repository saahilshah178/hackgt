        { "group": "^(head|headFocus|headShock)_0_Layer0_0_MEMBER_[012]_FILL$|^headBack_0_Layer0_[012]_FILL$|^hand_", "map": { "#FFD7B1": "skin", "#E7B687": "skinShade", "#F0C49A": "skinShade" } },
        { "group": "^(head|headFocus|headShock)_0_Layer0_1_FILL$|^Symbol_1_|^headBack_0_Layer0_3_FILL$", "map": { "#BF7958": "hair", "#DB855C": "hairHi" } },
